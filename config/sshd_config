Port 2222
AddressFamily any
ListenAddress 0.0.0.0

HostKey /ssh-host-keys/ssh_host_ed25519_key
PidFile /run/cgit-ssh/sshd.pid

AuthorizedKeysFile /access/ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey

AllowUsers git
PermitTTY no
PermitUserEnvironment no
PermitTunnel no
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
DisableForwarding yes
GatewayPorts no
MaxAuthTries 3
MaxSessions 4
ClientAliveInterval 300
ClientAliveCountMax 2
LoginGraceTime 30
UseDNS no
PrintMotd no
AcceptEnv GIT_PROTOCOL
# sshd constructs a fresh session environment; explicitly select its own role config.
SetEnv CGIT_RUNTIME_CONFIG=/run/cgit-ssh/runtime/settings.json
LogLevel VERBOSE
