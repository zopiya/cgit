# Copy chosen values into your instance .env; do not overwrite its other settings.
# Capacity example only: not proof of 100 GiB transfer throughput or reliability.
CGIT_LFS_MAX_SIZE=107374182400
CGIT_HTTP_MAX_REQUEST_SIZE=214748364800
CGIT_HTTP_IDLE_TIMEOUT=900
CGIT_LFS_MIN_FREE_BYTES=5368709120
# Leave concurrency/packing automatic until measured on your own hardware.
CGIT_HTTP_MAX_CONNECTIONS=1024
CGIT_GIT_PACK_THREADS=0
CGIT_GIT_PACK_WINDOW_MEMORY=0
