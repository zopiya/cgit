# Copy to .env. Keep real credentials in secrets/, never in this file.
# Use a different project name AND a separate checkout/data directory per instance.
COMPOSE_PROJECT_NAME=cgit-home
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Default public means anyone who can connect can read all published repositories.
# CGIT_AUTH_MODE=public
CGIT_HTTP_BIND=0.0.0.0
CGIT_HTTP_PORT=8080
CGIT_BASE_URL=
# CGIT_HTTP_PUSH=0
CGIT_LFS_MAX_SIZE=10737418240

# Personal HTTP account (docker-compose.write.yml only).
# The overlay defaults to private and HTTP push=1 when auth/push are unset.
# Explicit values override overlay defaults. See docs/SETUP.md.
# CGIT_USERNAME=owner

# Public HTTPS overlay: set actual DNS domain and contact address.
# CGIT_DOMAIN=git.example.com
# CGIT_ACME_EMAIL=admin@example.com

# Access overlay defaults to HTTP push=1; set 0 to disable it.
# SSH push is independently enabled by the access overlay, subject to ACL.
# CGIT_SSH_PUSH=1
# CGIT_SSH_BIND=0.0.0.0
# CGIT_SSH_PORT=2222
# Keep single quotes to preserve cgit's literal expansion variable.
# CGIT_SSH_CLONE_URL='ssh://git@git.example.com:2222/$CGIT_REPO_URL.git'
